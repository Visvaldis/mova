---
import Placeholder from './interactive/Placeholder.tsx';
import { interactiveInfo } from '../i18n/ui';
import { useTranslations, type Lang } from '../i18n/utils';

const { id, lang } = Astro.props as { id: string; lang: Lang };
const t = useTranslations(lang);

const info = interactiveInfo[id];
const icon = info?.icon ?? '✦';
const title = info?.title[lang] ?? id;
const desc = info?.desc[lang] ?? '';

// Built interactive islands. Astro can't attach client directives to dynamic
// component variables, so each built id gets an explicit conditional render
// below; ids not in BUILT render the styled Placeholder.
import SoundShift from './interactive/SoundShift.tsx';
import MythBuster from './interactive/MythBuster.tsx';
import OriginsTimeline from './interactive/OriginsTimeline.tsx';
import FamilyTree from './interactive/FamilyTree.tsx';
import UkrainianTimeline from './interactive/UkrainianTimeline.tsx';
import SlangDecoder from './interactive/SlangDecoder.tsx';
import AiLanguageLab from './interactive/AiLanguageLab.tsx';
import CreoleLab from './interactive/CreoleLab.tsx';
import VitalityMap from './interactive/VitalityMap.tsx';
import ScriptEvolver from './interactive/ScriptEvolver.tsx';
import WordTraveler from './interactive/WordTraveler.tsx';
import WordXray from './interactive/WordXray.tsx';
import RootsGarden from './interactive/RootsGarden.tsx';
import NameMap from './interactive/NameMap.tsx';
import ThoughtLens from './interactive/ThoughtLens.tsx';
import AccentAtlas from './interactive/AccentAtlas.tsx';
import ConlangWorkbench from './interactive/ConlangWorkbench.tsx';
import CodeVsSpeech from './interactive/CodeVsSpeech.tsx';
import NameSmith from './interactive/NameSmith.tsx';
import EsperantoMachine from './interactive/EsperantoMachine.tsx';
const BUILT = new Set(['sound-shift', 'myth-buster', 'origins-timeline', 'family-tree', 'ukrainian-timeline', 'slang-decoder', 'ai-language-lab', 'creole-lab', 'vitality-map', 'script-evolver', 'word-traveler', 'word-xray', 'roots-garden', 'name-map', 'thought-lens', 'accent-atlas', 'conlang-workbench', 'code-vs-speech', 'name-smith', 'esperanto-machine']);
const isBuilt = BUILT.has(id);
---

<div class="interactive-wrap" data-interactive={id}>
  {id === 'sound-shift' && <SoundShift client:visible lang={lang} />}
  {id === 'myth-buster' && <MythBuster client:visible lang={lang} />}
  {id === 'origins-timeline' && <OriginsTimeline client:visible lang={lang} />}
  {id === 'family-tree' && <FamilyTree client:visible lang={lang} />}
  {id === 'ukrainian-timeline' && <UkrainianTimeline client:visible lang={lang} />}
  {id === 'slang-decoder' && <SlangDecoder client:visible lang={lang} />}
  {id === 'ai-language-lab' && <AiLanguageLab client:visible lang={lang} />}
  {id === 'creole-lab' && <CreoleLab client:visible lang={lang} />}
  {id === 'vitality-map' && <VitalityMap client:visible lang={lang} />}
  {id === 'script-evolver' && <ScriptEvolver client:visible lang={lang} />}
  {id === 'word-traveler' && <WordTraveler client:visible lang={lang} />}
  {id === 'word-xray' && <WordXray client:visible lang={lang} />}
  {id === 'roots-garden' && <RootsGarden client:visible lang={lang} />}
  {id === 'name-map' && <NameMap client:visible lang={lang} />}
  {id === 'thought-lens' && <ThoughtLens client:visible lang={lang} />}
  {id === 'accent-atlas' && <AccentAtlas client:visible lang={lang} />}
  {id === 'conlang-workbench' && <ConlangWorkbench client:visible lang={lang} />}
  {id === 'code-vs-speech' && <CodeVsSpeech client:visible lang={lang} />}
  {id === 'name-smith' && <NameSmith client:visible lang={lang} />}
  {id === 'esperanto-machine' && <EsperantoMachine client:visible lang={lang} />}
  {
    !isBuilt && (
      <Placeholder
        icon={icon}
        title={title}
        desc={desc}
        badge={t('interactive.badge')}
        comingSoon={t('interactive.comingSoon')}
        note={t('interactive.note')}
      />
    )
  }
</div>
