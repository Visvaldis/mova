---
import LanguageToggle from './LanguageToggle.astro';
import { localizedPath, useTranslations, type Lang } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang; slug?: string };
const t = useTranslations(lang);

const links = [
  { href: localizedPath(lang), label: t('nav.home') },
  { href: localizedPath(lang, 'timeline'), label: t('nav.timeline') },
  { href: localizedPath(lang, 'playground'), label: t('nav.playground') },
  { href: localizedPath(lang, 'about'), label: t('nav.about') },
];

// Normalize for active-link comparison (ignore trailing slash differences).
const current = Astro.url.pathname.replace(/\/+$/, '');
const isCurrent = (href: string) => current === href.replace(/\/+$/, '');
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizedPath(lang)}>
      {t('brand')}<span class="dot">.</span>
      <small>{t('brand.tagline')}</small>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <LanguageToggle lang={lang} />
    </nav>
  </div>
</header>
