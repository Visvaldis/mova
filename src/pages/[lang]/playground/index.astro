---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGS, useTranslations, localizedPath, type Lang, type UIKey } from '../../../i18n/utils';
import { TOYS } from '../../../components/playground/registry';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('pg.title')} description={t('pg.intro')} topic="playground" slug="playground">
  <section class="page" style="max-width: var(--maxw);">
    <h1>{t('pg.title')}</h1>
    <p style="max-width: var(--maxw-prose);">{t('pg.intro')}</p>

    <div class="pg-hub-grid">
      {
        TOYS.map((toy) => (
          <a class="pg-card" href={localizedPath(lang, 'playground', toy.id)}>
            <span class="icon" aria-hidden="true">{toy.icon}</span>
            <h3>{t(`${toy.key}.title` as UIKey)}</h3>
            <p>{t(`${toy.key}.blurb` as UIKey)}</p>
            <span class="meta">
              {toy.daily && <span class="chip">{t('pg.daily')}</span>}
              <span class="chip">~{toy.minutes} {t('pg.minutes')}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
