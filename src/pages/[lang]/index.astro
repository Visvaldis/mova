---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { LANGS, useTranslations, langFromId, type Lang } from '../../i18n/utils';
import { topicNames } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const articles = (await getCollection('articles', (e) => langFromId(e.id) === lang)).sort(
  (a, b) => a.data.order - b.data.order
);

// Topic chips derive from the live article set (new topics appear automatically).
const topics = [...new Set(articles.map((a) => a.data.topic))];
---

<BaseLayout lang={lang} title="" description={t('home.hero.subtitle')}>
  <section class="container hero">
    <p class="kicker">{t('home.hero.kicker')}</p>
    <h1>{t('home.hero.title')}</h1>
    <p>{t('home.hero.subtitle')}</p>
  </section>

  <section class="container">
    <h2 class="section-title">{t('home.articles')}</h2>

    <div class="topic-filter" role="group" aria-label={t('home.filterAria')} data-topic-filter>
      <button class="filter-chip" data-filter="" aria-pressed="true">{t('home.filterAll')}</button>
      {
        topics.map((topic) => (
          <button class="filter-chip" data-filter={topic} data-topic={topic} aria-pressed="false">
            {topicNames[topic]?.[lang] ?? topic}
          </button>
        ))
      }
    </div>

    <div class="card-grid">
      {
        articles.map((a) => (
          <ArticleCard
            lang={lang}
            slug={a.data.slug}
            title={a.data.title}
            summary={a.data.summary}
            topic={a.data.topic}
            readingTime={a.data.readingTime}
            interactive={a.data.interactive}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: with JS off, every card stays visible.
  const bar = document.querySelector('[data-topic-filter]');
  const chips = Array.from(bar?.querySelectorAll<HTMLButtonElement>('.filter-chip') ?? []);
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card-grid .card'));

  function apply(topic: string) {
    for (const chip of chips) {
      chip.setAttribute('aria-pressed', String((chip.dataset.filter ?? '') === topic));
    }
    for (const card of cards) {
      card.hidden = topic !== '' && card.dataset.topic !== topic;
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const topic = chip.dataset.filter ?? '';
      apply(topic);
      // Shareable URL — #topic=<id>, dropped when "All" is selected.
      history.replaceState(null, '', topic ? `#topic=${topic}` : location.pathname + location.search);
    });
  }

  // Restore a shared filter from the hash on load.
  const m = location.hash.match(/^#topic=([\w-]+)$/);
  if (m && chips.some((c) => c.dataset.filter === m[1])) apply(m[1]);
</script>
