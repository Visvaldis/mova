---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MasterTimeline from '../../components/interactive/MasterTimeline.tsx';
import { LANGS, useTranslations, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('timeline.title')} description={t('timeline.intro')}>
  <section class="page">
    <h1>{t('timeline.title')}</h1>
    <p>{t('timeline.intro')}</p>

    <div class="interactive-wrap">
      <MasterTimeline client:visible lang={lang} />
    </div>
  </section>
</BaseLayout>
