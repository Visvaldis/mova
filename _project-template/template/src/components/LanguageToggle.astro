---
import { LANGS, withBase, useTranslations, type Lang } from '../i18n/utils';
import { ui } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

// Swap the language segment of the current path, keeping the user on the same
// page. Slugs are identical across languages, so /en/<slug>/ <-> /uk/<slug>/.
const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
let path = Astro.url.pathname;
if (BASE && path.startsWith(BASE)) path = path.slice(BASE.length);
const rest = path.split('/').filter(Boolean).slice(1).join('/');
const urlFor = (target: Lang) => withBase(rest ? `/${target}/${rest}/` : `/${target}/`);
---

<div class="lang-toggle" role="group" aria-label={t('lang.switch')}>
  {LANGS.map((l) => (
    <a
      href={urlFor(l)}
      hreflang={l}
      lang={l}
      aria-current={l === lang ? 'true' : 'false'}
      aria-label={ui[l]['lang.full']}
      data-lang-link
    >{ui[l]['lang.label']}</a>
  ))}
</div>

<script>
  // Preserve scroll position across a language switch.
  document.querySelectorAll('[data-lang-link]').forEach((el) => {
    el.addEventListener('click', () => {
      try { sessionStorage.setItem('site-scroll', String(window.scrollY)); } catch {}
    });
  });
</script>
