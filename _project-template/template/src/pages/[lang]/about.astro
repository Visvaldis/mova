---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANGS, useTranslations, type Lang } from '../../i18n/utils';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---
<BaseLayout lang={lang} title={t('about.title')} description={t('about.p1')}>
  <section class="page">
    <h1>{t('about.title')}</h1>
    <p>{t('about.p1')}</p>
    <p>{t('about.p2')}</p>
    <p>{t('about.p3')}</p>
  </section>
</BaseLayout>
